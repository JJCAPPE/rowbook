{
    "name": "rowbook",
    "private": true,
    "version": "0.1.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm --workspace apps/web run dev",
        "build": "npm --workspace apps/web run build",
        "lint": "npm --workspace apps/web run lint",
        "typecheck": "npm --workspace apps/web run typecheck",
        "prisma:generate": "npm --workspace apps/web run prisma:generate",
        "prisma:migrate": "npm --workspace apps/web run prisma:migrate",
        "postinstall": "npm --workspace apps/web run prisma:generate",
        "test": "npm run test:unit",
        "test:unit": "tsx --tsconfig apps/web/tsconfig.json --test tests/unit/*.test.ts",
        "test:integration": "tsx --tsconfig apps/web/tsconfig.json --test tests/integration/*.test.ts",
        "test:e2e": "python3 tests/e2e/smoke.py",
        "test:e2e:authenticated": "python3 tests/e2e/authenticated.py",
        "test:release": "npm run test:unit && npm run test:integration && npm run typecheck && npm run lint && npm run build",
        "test:provider": "tsx --test tests/proof-extraction-manual.test.ts"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.1",
        "@types/nodemailer": "^7.0.5",
        "tsx": "^4.23.13",
        "typescript": "^5.4.5"
    },
    "type": "module",
    "dependencies": {
        "dotenv": "^17.2.3"
    }
}
